{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "oq/books.schema.json",
  "title": "本棚 works/bookshelf/books.json（books は追記のみ）",
  "type": "object",
  "required": ["note", "books"],
  "additionalProperties": false,
  "properties": {
    "note": { "type": "string" },
    "books": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "href"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "href": { "type": "string", "pattern": "^https?://" }
        }
      }
    }
  }
}
